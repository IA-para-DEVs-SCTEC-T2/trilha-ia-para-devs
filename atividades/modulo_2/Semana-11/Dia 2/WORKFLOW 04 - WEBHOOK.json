    {
      "parameters": {
        "jsCode": "const impact = Number($json.impact ?? 0);\nconst retries = Number($json.retries ?? 0);\n\nconst riskScore = Math.min(10, impact * 2 + retries);\nconst deterministicLevel =\n  riskScore >= 8 ? \"high\" :\n  riskScore >= 5 ? \"medium\" : \"low\";\n\nreturn [{\n  json: {\n    ...$json,\n    riskScore,\n    deterministicLevel\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        16
      ],
      "id": "15339d80-8318-4799-9103-c5a2e2172a6b",
      "name": "Calculate Risk Score"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analise o evento abaixo.\n\nObjetivos:\n1. classificar o tipo de problema;\n2. definir severity como low, medium ou high;\n3. atribuir confidence entre 0 e 1;\n4. resumir a situação;\n5. recomendar a próxima ação;\n6. informar se precisa de revisão humana.\n\nEVENTO:\n{{ JSON.stringify($json) }}\n\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=Você atua como classificador dentro de um workflow automatizado.\nVocê não executa ações e não deve inventar fatos.\n\n\nRegras:\n- Use apenas o contexto recebido.\n- Não declare causa raiz como confirmada sem evidência.\n- Se faltarem dados importantes, reduza a confiança e sinalize revisão humana."
            }
          ]
        },
        "batching": {}
      },
